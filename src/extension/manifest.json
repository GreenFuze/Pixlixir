{
  "manifest_version": 3,
  "name": "Pixlixir",
  "short_name": "Pixlixir",
  "description": "Makes Google Photos more powerful: split scanned album pages into separate photos, stitch panoramas, and more to come.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Pixlixir", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://photos.google.com/*"],
  "content_scripts": [
    { "matches": ["https://photos.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [{ "resources": ["scan.html"], "matches": ["https://photos.google.com/*"] }],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
