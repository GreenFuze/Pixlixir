{
  "name": "pixlixir",
  "version": "0.3.0",
  "private": true,
  "description": "Pixlixir: a Chrome extension that makes Google Photos more powerful.",
  "license": "Apache-2.0",
  "author": "GreenFuze",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vendor": "node scripts/vendor-pyodide.mjs",
    "pretest": "node scripts/vendor-pyodide.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "build:probe": "esbuild tools/live-probe/probe.ts --bundle --format=iife --target=chrome116 --outfile=dist-probe/probe.js",
    "dev:split": "esbuild tools/dev/split-debug.ts --bundle --platform=node --format=esm --outfile=captures/.bin/split-debug.mjs --log-level=warning && node captures/.bin/split-debug.mjs",
    "dev:serve": "node tools/dev/serve.mjs 5174",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "blockhash-core": "^0.1.0",
    "idb": "^8.0.4",
    "onnxruntime-web": "^1.31.1",
    "p-limit": "^7.3.3",
    "piexifjs": "^1.0.6",
    "preact": "^11.1.1",
    "pyodide": "314.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "exifreader": "^4.54.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
