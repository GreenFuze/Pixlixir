{
  "name": "pixlixir",
  "version": "0.1.0",
  "private": true,
  "description": "Pixlixir: a Chrome extension that makes Google Photos more powerful.",
  "license": "Apache-2.0",
  "author": "GreenFuze",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "build:probe": "esbuild tools/live-probe/probe.ts --bundle --format=iife --target=chrome116 --outfile=dist-probe/probe.js"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "preact": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
